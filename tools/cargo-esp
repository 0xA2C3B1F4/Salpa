#!/bin/sh

set -eu

case "${RISSO_KEY_MCU:-esp32s3}" in
    esp32s2)
        compiler_prefix=xtensa-esp32s2-elf
        rust_target=xtensa-esp32s2-none-elf
        ;;
    esp32s3)
        compiler_prefix=xtensa-esp32s3-elf
        rust_target=xtensa-esp32s3-none-elf
        ;;
    *)
        echo "RISSO_KEY_MCU must be esp32s2 or esp32s3" >&2
        exit 1
        ;;
esac

if ! command -v "${compiler_prefix}-gcc" >/dev/null 2>&1; then
    echo "${compiler_prefix}-gcc is missing; source the export file created by espup" >&2
    exit 1
fi

if ! command -v "${compiler_prefix}-ar" >/dev/null 2>&1; then
    echo "${compiler_prefix}-ar is missing; source the export file created by espup" >&2
    exit 1
fi

if [ -z "${LIBCLANG_PATH:-}" ]; then
    echo "LIBCLANG_PATH is missing; source the export file created by espup" >&2
    exit 1
fi

cc_path=$(command -v "${compiler_prefix}-gcc")
ar_path=$(command -v "${compiler_prefix}-ar")
gcc_include=$("$cc_path" -print-file-name=include)
target_sysroot=$("$cc_path" -print-sysroot)
target_include="$target_sysroot/include"

if [ ! -f "$gcc_include/stdint.h" ] || [ ! -f "$target_include/stdint.h" ]; then
    echo "Xtensa C standard headers were not found under the active toolchain" >&2
    exit 1
fi

case "$rust_target" in
    xtensa-esp32s2-none-elf)
        export CC_xtensa_esp32s2_none_elf="$cc_path"
        export AR_xtensa_esp32s2_none_elf="$ar_path"
        export CFLAGS_xtensa_esp32s2_none_elf="${CFLAGS_xtensa_esp32s2_none_elf:+$CFLAGS_xtensa_esp32s2_none_elf }-mlongcalls"
        export BINDGEN_EXTRA_CLANG_ARGS_xtensa_esp32s2_none_elf="-isystem $gcc_include -isystem $target_include"
        ;;
    xtensa-esp32s3-none-elf)
        export CC_xtensa_esp32s3_none_elf="$cc_path"
        export AR_xtensa_esp32s3_none_elf="$ar_path"
        export CFLAGS_xtensa_esp32s3_none_elf="${CFLAGS_xtensa_esp32s3_none_elf:+$CFLAGS_xtensa_esp32s3_none_elf }-mlongcalls"
        export BINDGEN_EXTRA_CLANG_ARGS_xtensa_esp32s3_none_elf="-isystem $gcc_include -isystem $target_include"
        ;;
esac

export CARGO_BUILD_TARGET="$rust_target"

if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    : "${TMPDIR:?TMPDIR must point to the temporary-file directory}"
    CARGO_TARGET_DIR="${TMPDIR%/}/rissokey-target"
    export CARGO_TARGET_DIR
fi

exec cargo "$@"
